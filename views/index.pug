doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet" href="/css/style.css")
    body
        main
            h1 Time Capsules

            p.actions
                a.button(href="/new-time-capsule") Add a time capsule

            if data.length
                .cards
                    each capsule in data
                        article.card
                            h2.card__name= capsule.properties.name
                            p
                                strong Location:
                                |  #{capsule.properties.location || 'Not set'}
                            p
                                strong Open year:
                                |  #{capsule.properties.open_year || 'Not set'}
            else
                p.empty-state No time capsules were found.
